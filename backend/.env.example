# Copy to backend/.env (git-ignored) and replace every value. Docker Compose reads backend/.env
# because it sits next to docker-compose.yml. Make each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# (URL-safe characters only, so they can go into DATABASE_URL / REDIS_URL unchanged.)
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
OFFICER_TOKEN=change-me
TEAM_TOKEN=change-me
